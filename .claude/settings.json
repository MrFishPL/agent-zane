{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Bash(pip freeze *)",
      "Bash(python3 -m venv *)",
      "Bash(python3 -m pytest *)",
      "Bash(source */venv/bin/activate *)",
      "Bash(source .venv/bin/activate *)",
      "Bash(.venv/bin/python3 *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cat *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(*/venv/*)",
      "Read(.venv/*)"
    ]
  }
}
